# OpenAI connection for the full creative studio (optional for starter examples).
# AI creation, conversational code editing and runtime repair require a real API key.
# The portable preview/index.html cannot connect to OpenAI; run the full server.
# You may enter the key in the full app's connection panel instead: it is tested
# against the provider and retained only in server memory until restart.
# Copy this file to .env only for a new installation. Preserve an existing .env.
# Enter your own key locally; never send it in chat or commit .env.
# ChatGPT subscriptions do not include API billing. Provider requests can cost money.
DDUK_AI_API_KEY=
# Select a model available to your OpenAI account that supports Structured Outputs.
DDUK_AI_MODEL=gpt-4.1
DDUK_AI_BASE_URL=https://api.openai.com/v1

# This version is a single-user local workspace. Keep the backend private.
HOST=127.0.0.1
PORT=3001
# Optional comma-separated exact origins for your trusted private development proxy.
# This setting configures BOTH Vite's host allowlist and the backend origin allowlist.
# Copy the HTTPS origin from your trusted proxy address: scheme + host + optional port.
# Do not include a trailing slash, path, query, credentials, wildcard, or leading dot.
# Plain HTTP is accepted only for localhost/127.0.0.1/[::1] development origins.
# Restart `npm run dev` after editing this value so both servers reload it.
# This does not add sign-in. Keep the workspace behind a private authenticated gateway.
# DDUK_ALLOWED_ORIGINS=http://localhost:5173
